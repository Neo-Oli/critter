{
    "name": "critter",
    "version": "0.0.0",
    "description": "",
    "main": "./dist/index.js",
    "scripts": {
        "test": "vitest run --reporter=verbose",
        "test:check": "pnpm run check",
        "test:snap": "vitest run -u",
        "test:watch": "vitest",
        "lint": "eslint . --color --ext js,jsx,ts,tsx --fix && prettier . --write && find . -type d -name node_modules -prune -o -type f \\( -name '*.sh' -o -name '*.bash' \\) -exec shfmt --binary-next-line --space-redirects --indent 4 --case-indent -l -w --simplify {} +",
        "check": "tsc --noEmit",
        "build": "esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --loader:.txt=text --outfile=dist/index.js",
        "start": "node dist/index.js"
    },
    "bin": {
        "critter": "./dist/index.js"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "author": "glow",
    "license": "GPL-3.0-only",
    "devDependencies": {
        "@cofy-x/pixel-to-ascii": "latest",
        "@eslint/json": "latest",
        "@stylistic/eslint-plugin": "latest",
        "@types/node": "latest",
        "esbuild": "latest",
        "eslint": "latest",
        "eslint-config-flat-gitignore": "latest",
        "eslint-config-prettier": "latest",
        "eslint-plugin-comment-length": "latest",
        "eslint-plugin-import": "latest",
        "eslint-plugin-perfectionist": "latest",
        "eslint-plugin-prettier": "latest",
        "globals": "latest",
        "prettier": "latest",
        "typescript": "^6.0.3",
        "typescript-eslint": "latest",
        "vitest": "latest"
    }
}
