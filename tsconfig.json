{
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "outDir": "dist",
        "rootDir": "src",
        "noEmit": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "exclude": ["node_modules", "dist"],
    "include": ["src/**/*"]
}
